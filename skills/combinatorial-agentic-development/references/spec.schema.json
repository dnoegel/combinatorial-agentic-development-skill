{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://combinatorial-agentic-development/spec.schema.json",
  "title": "Combinatorial Agentic Development spec",
  "description": "Canonical decision space. Stored in a ```yaml cad-spec block of a planning document, or as a standalone YAML/JSON file.",
  "type": "object",
  "required": [
    "feature",
    "dimensions"
  ],
  "properties": {
    "cad": {
      "type": "integer",
      "description": "Spec format version."
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Slug used for branch names."
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "description": "Ordered mapping of decision id to its options.",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "label": {
                      "type": "string"
                    },
                    "noop": {
                      "type": "boolean"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          {
            "type": "object",
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                        },
                        "label": {
                          "type": "string"
                        },
                        "noop": {
                          "type": "boolean"
                        },
                        "summary": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "minItems": 1
              },
              "label": {
                "type": "string"
              },
              "applies_when": {
                "type": "string"
              },
              "bundle": {
                "type": "boolean"
              },
              "summary": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "if": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          },
          "excludes": {
            "type": "string"
          },
          "never": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "when": {
            "type": "string",
            "description": "Constraint expression, e.g. `pdf_delivery == email and email_capture != disabled`."
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "exhaustive",
            "pairwise",
            "twise",
            "selected"
          ]
        },
        "strength": {
          "type": "integer",
          "minimum": 1
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Dimension id to option id."
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_variants": {
          "type": "integer",
          "minimum": 1,
          "description": "Targeted variants above this need a confirmation."
        },
        "max_enumeration": {
          "type": "integer",
          "minimum": 1,
          "description": "Theoretical combinations above this are refused."
        }
      }
    },
    "stack": {
      "type": "object",
      "properties": {
        "base_branch": {
          "type": "string"
        },
        "branch_prefix": {
          "type": "string"
        },
        "layout": {
          "enum": [
            "tree",
            "linear"
          ]
        },
        "max_coupling": {
          "type": "integer",
          "minimum": 0,
          "description": "Most nodes a graft may stack on code they do not need."
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "Node id (base, dim.<d>, opt.<d>.<o>, ix.<id>) to repository-specific details.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "components": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "files": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "guidance": {
            "type": "string"
          },
          "tests": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "acceptance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "complexity": {
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verify": {
      "type": "object",
      "description": "Commands used by `cad.py verify`.",
      "properties": {
        "test": {
          "type": "string",
          "description": "Test command, run with all branches merged."
        },
        "probe": {
          "type": "string",
          "description": "Receives a variant as JSON (stdin and CAD_VARIANT) and prints the options it observes as dimension=option tokens."
        }
      }
    }
  }
}
